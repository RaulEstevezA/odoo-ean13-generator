<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ean13_generate_wizard_view_form" model="ir.ui.view">
        <field name="name">ean13.generate.wizard.view.form</field>
        <field name="model">ean13.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar códigos EAN-13">
                <group invisible="state != 'confirm'">
                    <field
                        name="product_ids"
                        widget="many2many_tags"
                    />
                </group>

                <group invisible="state != 'done'">
                    <group>
                        <field name="success_count"/>
                        <field name="error_count"/>
                    </group>

                    <field
                        name="result_details"
                        nolabel="1"
                    />
                </group>

                <footer>
                    <button
                        name="action_generate_ean13"
                        type="object"
                        string="Generar"
                        class="btn-primary"
                        invisible="state != 'confirm'"
                    />
                    <button
                        string="Cerrar"
                        special="cancel"
                        class="btn-secondary"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ean13_generate_wizard" model="ir.actions.act_window">
        <field name="name">Generar códigos EAN-13</field>
        <field name="res_model">ean13.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field
            name="binding_model_id"
            ref="product.model_product_product"
        />
        <field name="binding_view_types">list</field>
        <field
            name="groups_id"
            eval="[Command.link(ref('product_ean13_generator.group_ean13_generator'))]"
        />
    </record>
</odoo>