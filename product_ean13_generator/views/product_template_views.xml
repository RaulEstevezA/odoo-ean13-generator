<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Ficha de producto (plantilla). Solo muestra el botón cuando el
        producto tiene una única variante, igual que el campo código de barras.
    -->
    <record
        id="product_template_only_form_view_inherit_ean13"
        model="ir.ui.view"
    >
        <field name="name">
            product.template.product.form.inherit.ean13
        </field>
        <field name="model">product.template</field>
        <field
            name="inherit_id"
            ref="product.product_template_only_form_view"
        />
        <field name="arch" type="xml">
            <field name="barcode" position="after">
                <field name="can_generate_ean13" invisible="1"/>

                <button
                    name="action_generate_ean13"
                    type="object"
                    string="Generar EAN-13"
                    class="btn btn-secondary"
                    groups="product_ean13_generator.group_ean13_generator"
                    invisible="not can_generate_ean13 or type in ['service', 'combo']"
                />
            </field>
        </field>
    </record>
</odoo>
